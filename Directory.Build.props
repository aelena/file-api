<Project>

  <!--
    Solution-wide build settings. Applies to src/, tests/ and the grpc/ minirepo
    alike — every csproj under this directory inherits it, so no project needs to
    restate a TargetFramework or language version.
  -->
  <PropertyGroup>
    <!--
      Built and tested against both the current LTS and the next preview, so a
      regression on either shows up here rather than in someone's upgrade.
      Set -p:TargetFrameworks=net10.0 to build only the LTS target if the .NET 11
      SDK is not installed.
    -->
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!--
    PDF support is AGPL, because iText 7 is. Everything else in this repository
    is MIT. Building with -p:IncludePdf=false drops the PDF projects, endpoints
    and commands entirely, producing a deployable with no copyleft code in it —
    so a cloner who cannot accept the AGPL has a supported way out rather than
    having to delete code by hand. CI publishes both ways and asserts that the
    opt-out output contains no iText assembly.
  -->
  <PropertyGroup>
    <IncludePdf Condition="'$(IncludePdf)' == ''">true</IncludePdf>
    <DefineConstants Condition="'$(IncludePdf)' == 'true'">$(DefineConstants);INCLUDE_PDF</DefineConstants>
  </PropertyGroup>

  <!-- Analyzers: the whole ruleset, not just the default subset. -->
  <PropertyGroup>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <!--
    Dependencies are pinned exactly (see Directory.Packages.props) rather than
    floated with `8.*`. Floating ranges are how Scriban silently drifted onto a
    build-breaking advisory; a pin plus NuGetAudit surfaces that as a deliberate
    upgrade instead.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>
  </PropertyGroup>

  <!--
    Temporary, accepted risk (2026-10-27). SixLabors.ImageSharp 3.1.12 carries
    these advisories. GHSA-v76p-62qx-wwq2 is fixed in 3.2.0, the rest only in
    4.1.2+, and both add a Six Labors licence check that fails Release builds
    without a key. Remove this group once
    ImageSharp is upgraded or replaced. Any advisory not listed still fails
    restore. The security workflow reads this list too, so keep it the only one.
  -->
  <ItemGroup Label="Suppressed advisories">
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-gwg2-r3hj-4w44" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-j3p4-wp97-rph4" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-j9gm-c75j-xc9q" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-jjfr-hcj7-qf5w" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-v76p-62qx-wwq2" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-wmxv-xphr-5c9g" />
  </ItemGroup>

</Project>
