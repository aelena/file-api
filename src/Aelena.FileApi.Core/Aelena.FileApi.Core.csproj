<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Aelena.FileApi.Core</RootNamespace>
    <PackageId>Aelena.FileApi.Core</PackageId>
    <Version>0.4.3</Version>
    <Authors>aelena</Authors>
    <Description>Pure document processing library — DOCX, EPUB, MOBI, DjVu, legacy .doc, image, email, hash, PII, readability, text and ZIP. Reads ebook and legacy office containers down to text and Markdown, with structural validation before any conversion is attempted. Zero ASP.NET dependencies, MIT licensed, no copyleft dependencies. PDF operations live in Aelena.FileApi.Core.Pdf, which is AGPL because iText 7 is.</Description>
    <PackageTags>document;docx;epub;mobi;djvu;doc;markdown;image;email;hash;pii;readability;zip</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/aelena/fileapi</RepositoryUrl>
    <IsPackable>true</IsPackable>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Auth (JWT) -->
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" />
    <PackageReference Include="Microsoft.IdentityModel.Tokens" />

    <!-- Token counting -->
    <PackageReference Include="SharpToken" />

    <!-- SQLite persistence -->
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="Dapper" />

    <!-- Templating -->
    <PackageReference Include="Scriban" />

    <!-- DOCX / Office -->
    <PackageReference Include="DocumentFormat.OpenXml" />

    <!-- Email -->
    <PackageReference Include="MimeKit" />

    <!-- Image -->
    <PackageReference Include="SixLabors.ImageSharp" />
    <PackageReference Include="SixLabors.ImageSharp.Drawing" />
  </ItemGroup>


  <!-- Shown on the NuGet listing page. Each package carries its own, so the
       licence position is visible before anyone installs it. -->
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
